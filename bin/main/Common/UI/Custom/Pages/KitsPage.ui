$C = "../Common.ui";

Group {
  Background: (Color: #000000(0.75));

  Group {
    Anchor: (Width: 650, Height: 580);

    Group #TitleBar {
      Anchor: (Height: 70, Top: 0);
      Background: (Color: #0a0f17);

      Group {
        Anchor: (Height: 2, Bottom: 0);
        Background: (Color: #1e2c3f);
      }

      Label {
        Text: "EQUIPMENT KITS";
        Style: (
          FontSize: 26,
          RenderBold: true,
          TextColor: #d4dfe8,
          RenderUppercase: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
          LetterSpacing: 2
        );
      }
    }

    Group #Content {
      LayoutMode: Top;
      Anchor: (Top: 70, Bottom: 0);
      Background: (Color: #0d1521);
      Padding: (Horizontal: 25, Vertical: 20);

      Group #Header {
        LayoutMode: Top;
        Anchor: (Bottom: 18);

        Label #Subtitle {
          Text: "Select a kit to equip yourself";
          Style: (
            FontSize: 13,
            TextColor: #7a90a8,
            RenderUppercase: true,
            LetterSpacing: 0.5
          );
          Anchor: (Bottom: 16);
        }

        Group #Controls {
          LayoutMode: Left;
          Anchor: (Bottom: 14, Height: 44);

          Group #SearchWrapper {
            FlexWeight: 1;
            Anchor: (Height: 44, Right: 12);
            Background: (Color: #161e2b);
            Padding: (Full: 2);

            TextField #SearchInput {
              PlaceholderText: "Search kits...";
              Style: (
                FontSize: 15,
                TextColor: #d4dfe8
              );
              PlaceholderStyle: (
                TextColor: #4a5d75,
                FontSize: 15
              );
              Background: (Color: #00000000);
              Padding: (Horizontal: 18, Vertical: 12);
            }
          }

          Button #RandomKitButton {
            Anchor: (Width: 160, Height: 44);
            Background: (Color: #1e2c3f);
            Style: ButtonStyle(
              Default: (
                Background: (Color: #1e2c3f)
              ),
              Hovered: (
                Background: (Color: #273649)
              ),
              Pressed: (
                Background: (Color: #19273a)
              ),
              Sounds: $C.@ButtonSounds
            );

            Label {
              Text: "RANDOM KIT";
              Style: (
                FontSize: 12,
                TextColor: #b4c4d3,
                RenderBold: true,
                RenderUppercase: true,
                HorizontalAlignment: Center,
                VerticalAlignment: Center,
                LetterSpacing: 1.5
              );
            }
          }
        }

        Group #Separator {
          Anchor: (Height: 2, Bottom: 0);
          Background: (Color: #1e2c3f);
        }
      }

      Group #KitListContainer {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@TranslucentScrollbarStyle;

        Group #KitCards {
          LayoutMode: Top;
        }
      }

      Group #Footer {
        LayoutMode: Top;
        Anchor: (Top: 14, Height: 36);

        Group #FooterLine {
          Anchor: (Height: 2, Bottom: 0);
          Background: (Color: #1e2c3f);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 12);

          Group {
            FlexWeight: 1;
          }

          Label #KitCount {
            Text: "";
            Style: (
              FontSize: 11,
              TextColor: #6a7d94,
              VerticalAlignment: Center,
              RenderUppercase: true,
              LetterSpacing: 1.2
            );
          }
        }
      }
    }
  }
}

$C.@BackButton {}

